<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Hardened Runtime для нотаризації. PyInstaller-бандл вантажить власні
       .so/.dylib і CPython робить JIT-подібні речі через ctypes — без цих
       двох прав підписаний застосунок падає на старті. Мережевих прав НЕМАЄ
       свідомо: DupScan не ходить у мережу (лише канал оновлень, читання). -->
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
</dict>
</plist>
